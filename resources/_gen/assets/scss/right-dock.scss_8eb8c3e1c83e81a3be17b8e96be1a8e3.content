nd:0 0!important;pointer-events:none!important;z-index:-1!important;overflow:visible!important;box-shadow:none!important}.right-dock .trophy-button{width:var(--dock-item-width)!important;height:var(--dock-item-height)!important;border-radius:50%!important;padding:0!important;margin:0!important;border:none!important;box-shadow:var(--dock-item-shadow)!important;background:var(--dock-item-bg)!important;backdrop-filter:var(--dock-backdrop-filter)!important;position:relative!important;display:flex!important;align-items:center!important;justify-content:center!important;cursor:pointer!important;transition:all .3s cubic-bezier(.4,0,.2,1)!important;min-width:var(--dock-item-width)!important;max-width:var(--dock-item-width)!important;min-height:var(--dock-item-height)!important;max-height:var(--dock-item-height)!important;aspect-ratio:1!important}.right-dock .trophy-button:hover{transform:scale(1.1)!important;background:var(--dock-item-bg-hover)!important;box-shadow:var(--dock-item-shadow-hover)!important}.right-dock .trophy-button .trophy-icon{font-size:1.2rem!important;color:gold!important;z-index:2!important;position:relative!important}.right-dock .trophy-progress-circle{position:absolute!important;top:0!important;left:0!important;right:0!important;bottom:0!important;z-index:1!important;pointer-events:none!important}.right-dock .trophy-progress-circle{width:100%!important;height:100%!important;transform:rotate(-90deg)!important}.right-dock .trophy-progress-track{fill:none!important;stroke:rgba(255,215,0,.15)!important;stroke-width:2!important}.right-dock .trophy-progress-bar{fill:none!important;stroke-width:2!important;stroke-linecap:round!important;transition:stroke-dashoffset .5s cubic-bezier(.4,0,.2,1)!important;filter:drop-shadow(0 0 3px rgba(255,215,0,.4))!important;width:auto!important;height:auto!important;background:0 0!important;border-radius:0!important;box-shadow:none!important}.trophies-btn.new-trophy{animation:newTrophyPulse 2s ease-in-out}.trophies-btn.new-trophy .trophy-progress-bar{animation:progressGlow 2s ease-in-out}@keyframes newTrophyPulse{0%,100%{transform:scale(1);box-shadow:0 2px 8px rgba(0,0,0,.2)}25%,75%{transform:scale(1.1);box-shadow:0 4px 16px rgba(255,215,0,.3),0 0 0 2px rgba(255,215,0,.2)}50%{transform:scale(1.15);box-shadow:0 6px 20px rgba(255,215,0,.4),0 0 0 4px rgba(255,215,0,.3)}}@keyframes progressGlow{0%,100%{filter:drop-shadow(0 0 3px rgba(255,215,0,.4))}50%{filter:drop-shadow(0 0 6px rgba(255,215,0,.8))}}.theme-toggle{position:relative}.theme-icon{transition:opacity .3s ease,transform .3s ease}.theme-icon-light{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);opacity:0}[data-theme=dark] .theme-icon-dark{opacity:0}[data-theme=dark] .theme-icon-light{opacity:1}.language-btn{position:relative}.language-item{position:relative}.language-flag{position:absolute;bottom:0;right:0;font-size:12px;line-height:1;filter:drop-shadow(0 1px 2px rgba(0,0,0,.3))}.language-dropdown{position:absolute;top:calc(100% + 12px);right:0;min-width:160px;background:rgba(255,255,255,.98);backdrop-filter:blur(25px);border:1px solid rgba(255,255,255,.3);border-radius:16px;box-shadow:0 12px 40px rgba(0,0,0,.15),0 4px 12px rgba(0,0,0,8%),inset 0 1px rgba(255,255,255,.4);opacity:0;visibility:hidden;transform:translateY(-15px)scale(.95);transition:all .25s cubic-bezier(.4,0,.2,1);z-index:1003;padding:8px 0}.language-dropdown::before{content:'';position:absolute;top:-6px;right:20px;width:12px;height:12px;background:rgba(255,255,255,.98);border:1px solid rgba(255,255,255,.3);border-bottom:none;border-right:none;transform:rotate(45deg);backdrop-filter:blur(25px)}@media(prefers-color-scheme:dark){.language-dropdown{background:rgba(25,25,25,.98);border:1px solid rgba(255,255,255,.15);box-shadow:0 12px 40px rgba(0,0,0,.4),0 4px 12px rgba(0,0,0,.25),inset 0 1px rgba(255,255,255,.1)}.language-dropdown::before{background:rgba(25,25,25,.98);border-color:rgba(255,255,255,.15)}}.language-dropdown.active{opacity:1!important;visibility:visible!important;transform:translateY(0)scale(1)!important}.language-option{display:flex;align-items:center;gap:8px;padding:10px 12px;color:var(--text-primary);text-decoration:none;font-size:14px;font-weight:500;transition:background-color .2s ease}.language-option:first-child{border-top-left-radius:12px;border-top-right-radius:12px}.language-option:last-child{border-bottom-left-radius:12px;border-bottom-right-radius:12px}.language-option:hover{background:rgba(0,0,0,5%)}@media(prefers-color-scheme:dark){.language-option:hover{background:rgba(255,255,255,.1)}}.language-option.active{background:rgba(0,123,255,.1);color:var(--accent-color)}.language-option .flag{font-size:16px}@media(max-width:1024px){.right-dock{top:16px;right:16px}}@media(max-width:768px){:root{--right-dock-button-size:var(--right-dock-button-size-mobile);--right-dock-padding:8px;--right-dock-gap:6px;--right-dock-top:12px;--right-dock-right:12px}.right-dock{opacity:0!important;pointer-events:none!important;visibility:hidden!important}.right-dock{border-radius:24px}.right-dock .dock-button{width:40px;height:40px}.right-dock .dock-button:hover,.right-dock .dock-button:focus-visible{transform:scale(1.15)}.right-dock .dock-icon{width:20px;height:20px}.trophies-btn{width:40px!important;height:40px!important}.trophies-btn .dock-icon{width:16px;height:16px}.trophy-count{font-size:7px}.trophy-progress-track,.trophy-progress-bar{stroke-width:1.5}.right-dock .dock-label,.right-dock .dock-tooltip{font-size:.75rem;bottom:110%}}@media(max-width:480px){:root{--right-dock-top:8px;--right-dock-right:8px}.right-dock .dock-button{width:36px;height:36px}.trophies-btn{width:36px!important;height:36px!important}.trophies-btn .dock-icon{width:14px;height:14px}.trophy-count{font-size:6px}.right-dock .dock-icon{width:18px;height:18px}}body{padding-right:calc(var(--right-dock-width,0px) + 40px)}@media(max-width:768px){body{padding-right:0}}@media(max-width:480px){body{padding-right:0}}@media(prefers-reduced-motion:reduce){.right-dock,.right-dock .dock-button,.right-dock .dock-icon,.right-dock .dock-label{transition-duration:50ms}}@media(hover:none){.right-dock .dock-button:hover{transform:none;background:0 0;box-shadow:none}.right-dock .dock-button:hover .dock-label{opacity:0;visibility:hidden;transform:translateX(-50%)translateY(8px)scale(.9)}}