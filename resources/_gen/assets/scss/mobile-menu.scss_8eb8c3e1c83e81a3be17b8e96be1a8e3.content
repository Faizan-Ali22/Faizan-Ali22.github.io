@charset "UTF-8";body.mobile-menu-open,html:has(body.mobile-menu-open){overflow:hidden!important;height:100dvh;position:fixed;width:100%}:root{--mobile-menu-bg:rgba(47, 47, 47, 0.35);--mobile-menu-border:rgba(255, 255, 255, 0.40);--mobile-menu-text:#F4F4F5;--mobile-menu-accent:#4fd1c7;--mobile-menu-blur:10px;--mobile-menu-shadow:rgba(0, 0, 0, 0.4)}[data-theme=light]{--mobile-menu-bg:rgba(255, 255, 255, 0.75);--mobile-menu-border:rgba(0, 0, 0, 0.1);--mobile-menu-text:#1A1A1A;--mobile-menu-accent:#0070F3;--mobile-menu-shadow:rgba(0, 0, 0, 0.15);--mobile-menu-blur:16px}.mobile-menu-toggle{display:none;position:fixed;top:12px;right:12px;z-index:2000;width:48px;height:48px;border:none;border-radius:24px;background:var(--mobile-menu-bg);backdrop-filter:blur(var(--mobile-menu-blur));border:1px solid var(--mobile-menu-border);box-shadow:0 4px 16px var(--mobile-menu-shadow);cursor:pointer;padding:0;transition:all .3s cubic-bezier(.23,1,.32,1);-webkit-tap-highlight-color:transparent}.mobile-menu-toggle:hover{transform:scale(1.05);box-shadow:0 6px 20px var(--mobile-menu-shadow)}.mobile-menu-toggle:active{transform:scale(.95)}.mobile-menu-toggle.is-open{background:var(--mobile-menu-accent)}.mobile-menu-toggle.is-open .hamburger-line{background:#fff}.mobile-menu-toggle.is-open .hamburger-line:nth-child(1){transform:translateY(6px)rotate(45deg)}.mobile-menu-toggle.is-open .hamburger-line:nth-child(2){opacity:0;transform:scaleX(0)}.mobile-menu-toggle.is-open .hamburger-line:nth-child(3){transform:translateY(-6px)rotate(-45deg)}.hamburger-icon{display:flex;flex-direction:column;align-items:center;justify-content:center;width:24px;height:24px;margin:0 auto}.hamburger-line{width:20px;height:2px;background:var(--mobile-menu-text);border-radius:2px;transition:all .3s cubic-bezier(.23,1,.32,1)}.hamburger-line:not(:last-child){margin-bottom:4px}.mobile-menu-notification-badge{position:absolute;top:-4px;right:-4px;background:#ff3b30;color:#fff;border-radius:50%;font-size:11px;font-weight:700;min-width:20px;height:20px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(255,59,48,.4),0 2px 4px rgba(0,0,0,.1);animation:pulse-mobile-badge 2s ease-in-out infinite;z-index:1;pointer-events:none;opacity:1;transition:opacity .3s cubic-bezier(.23,1,.32,1)}@keyframes pulse-mobile-badge{0%,100%{transform:scale(1);box-shadow:0 4px 12px rgba(255,59,48,.4),0 2px 4px rgba(0,0,0,.1)}50%{transform:scale(1.1);box-shadow:0 6px 16px rgba(255,59,48,.6),0 3px 6px rgba(0,0,0,.15)}}.mobile-menu-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:1998;background:rgba(0,0,0,.5);backdrop-filter:blur(2px);opacity:0;pointer-events:none;transition:opacity .3s ease-out}.mobile-menu-overlay.is-open{opacity:1;pointer-events:all}.mobile-menu-dropdown{display:none;position:fixed;top:0;left:0;right:0;bottom:0;z-index:1999;width:100vw;height:100dvh;overflow-y:auto;background:var(--mobile-menu-bg);backdrop-filter:blur(20px);border:none;opacity:0;transform:translateY(-10px)scale(.95);pointer-events:none;transition:all .3s cubic-bezier(.23,1,.32,1)}.mobile-menu-dropdown.is-open{opacity:1;transform:translateY(0)scale(1);pointer-events:all}.mobile-menu-dropdown::-webkit-scrollbar{width:6px}.mobile-menu-dropdown::-webkit-scrollbar-track{background:rgba(255,255,255,5%);border-radius:3px}.mobile-menu-dropdown::-webkit-scrollbar-thumb{background:rgba(255,255,255,.2);border-radius:3px}.mobile-menu-dropdown::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.3)}.mobile-menu-content{padding:80px 24px 24px;max-width:480px;margin:0 auto;min-height:100dvh;display:flex;flex-direction:column}.mobile-menu-profile{display:flex;align-items:center;gap:16px;padding:16px;background:rgba(255,255,255,8%);border-radius:16px;margin-bottom:16px;transition:all .2s ease-out}.mobile-menu-profile:hover{background:rgba(255,255,255,.12)}.mobile-profile-avatar{width:56px;height:56px;border-radius:50%;overflow:hidden;flex-shrink:0;border:2px solid rgba(255,255,255,.2);box-shadow:0 4px 12px rgba(0,0,0,.2)}.mobile-avatar-image{width:100%;height:100%;object-fit:cover}.mobile-profile-info{display:flex;flex-direction:column;gap:4px;flex:1;min-width:0}.mobile-profile-name{font-size:17px;font-weight:700;color:var(--mobile-menu-text);line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mobile-profile-role{font-size:13px;font-weight:500;color:var(--mobile-menu-text);opacity:.7;line-height:1.2;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mobile-menu-section{margin-bottom:16px}.mobile-menu-section:last-child{margin-bottom:0}.mobile-menu-actions{display:flex;flex-direction:column;gap:4px}.mobile-menu-item{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;border:none;border-radius:12px;background:rgba(255,255,255,5%);color:var(--mobile-menu-text);text-decoration:none;font-size:15px;font-weight:500;cursor:pointer;transition:all .2s ease-out;width:100%;text-align:left;-webkit-tap-highlight-color:transparent}.mobile-menu-item:hover{background:rgba(255,255,255,.15);transform:translateX(4px)}.mobile-menu-item:active{transform:translateX(2px)scale(.98);background:rgba(255,255,255,.2)}.mobile-menu-item-content{display:flex;align-items:center;gap:12px;flex:1}.mobile-menu-icon{width:20px;height:20px;flex-shrink:0;color:var(--mobile-menu-accent);position:static!important;transform:none!important;opacity:1!important;top:auto!important;left:auto!important}.mobile-menu-emoji{font-size:20px;flex-shrink:0}.mobile-menu-label{flex:1;color:var(--mobile-menu-text)}.mobile-menu-separator{height:1px;background:rgba(255,255,255,.1);margin:16px 0}.trophy-count-badge{padding:4px 10px;background:rgba(255,215,0,.2);color:gold;border-radius:12px;font-size:12px;font-weight:700;flex-shrink:0;min-width:36px;text-align:center}.notification-badge-mobile{padding:4px 10px;background:rgba(255,59,48,.2);color:#ff3b30;border-radius:12px;font-size:12px;font-weight:700;min-width:24px;text-align:center;flex-shrink:0}.mobile-menu-theme .theme-icon-dark,.mobile-menu-theme .theme-icon-light{position:static!important;transform:none!important;opacity:1!important}.mobile-menu-theme .theme-icon-dark{display:none}.mobile-menu-theme .theme-icon-light{display:inline-block}[data-theme=light] .mobile-menu-theme .theme-icon-dark{display:inline-block}[data-theme=light] .mobile-menu-theme .theme-icon-light{display:none}.mobile-menu-trophies .mobile-menu-icon{filter:drop-shadow(0 0 4px rgba(255,215,0,.3))}.mobile-menu-language-section{display:flex;flex-direction:column;gap:8px;padding:12px 16px;border-radius:12px;background:rgba(255,255,255,5%)}.mobile-menu-language-header{display:flex;align-items:center;gap:12px;color:var(--mobile-menu-text);font-weight:500}.mobile-menu-language-options{display:flex;flex-direction:column;gap:4px;margin-left:32px}.mobile-menu-language-option{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;background:rgba(255,255,255,3%);color:var(--mobile-menu-text);text-decoration:none;font-size:14px;transition:all .2s ease-out}.mobile-menu-language-option:hover{background:rgba(255,255,255,.1);transform:translateX(4px)}.mobile-menu-language-option.active{background:rgba(79,209,199,.15);color:var(--mobile-menu-accent);font-weight:600}.mobile-menu-language-option .language-flag{font-size:18px;line-height:1;position:static!important;bottom:auto!important;right:auto!important;flex-shrink:0}.language-name{flex:1}.language-check{color:var(--mobile-menu-accent);font-weight:700;font-size:16px}[data-theme=light] .mobile-menu-toggle.is-open .hamburger-line{background:#fff}[data-theme=light] .mobile-menu-item{background:rgba(0,0,0,5%)}[data-theme=light] .mobile-menu-item:hover{background:rgba(0,0,0,.1)}[data-theme=light] .mobile-menu-item:active{background:rgba(0,0,0,.15)}[data-theme=light] .mobile-menu-separator{background:rgba(0,0,0,.1)}[data-theme=light] .mobile-menu-language-section{background:rgba(0,0,0,5%)}[data-theme=light] .mobile-menu-language-option{background:rgba(0,0,0,3%)}[data-theme=light] .mobile-menu-language-option:hover{background:rgba(0,0,0,.1)}[data-theme=light] .mobile-menu-language-option.active{background:rgba(0,112,243,.15)}[data-theme=light] .trophy-count-badge{background:rgba(255,215,0,.25);color:#c9a000}[data-theme=light] .notification-badge-mobile{background:rgba(255,59,48,.25);color:#d32f2f}[data-theme=light] .mobile-menu-trophies .mobile-menu-icon{filter:drop-shadow(0 0 4px rgba(255,215,0,.4))}[data-theme=light] .mobile-menu-profile{background:rgba(0,0,0,8%)}[data-theme=light] .mobile-menu-profile:hover{background:rgba(0,0,0,.12)}[data-theme=light] .mobile-profile-avatar{border-color:rgba(0,0,0,.15)}@media(max-width:768px){.mobile-menu-toggle{display:flex;align-items:center;justify-content:center}.mobile-menu-toggle:hover,.mobile-menu-toggle:active{transform:none!important}.mobile-menu-toggle:active{transform:scale(.95)!important}.mobile-menu-overlay{display:block}.mobile-menu-dropdown{display:block}}.mobile-menu-notifications-view{padding:80px 24px 24px;max-width:480px;margin:0 auto;min-height:100dvh;display:flex;flex-direction:column}.mobile-menu-notifications-header{display:flex;flex-direction:column;gap:16px;margin-bottom:24px}.mobile-notifications-back-btn{display:flex;align-items:center;gap:8px;padding:12px 16px;background:rgba(255,255,255,8%);border:1px solid rgba(255,255,255,.12);border-radius:12px;color:var(--mobile-menu-text);font-size:14px;font-weight:500;cursor:pointer;transition:all .2s ease-out;align-self:flex-start}.mobile-notifications-back-btn .back-icon{width:20px;height:20px}.mobile-notifications-back-btn:hover{background:rgba(255,255,255,.12);transform:translateX(-2px)}.mobile-notifications-back-btn:active{transform:scale(.98)}.mobile-notifications-title-row{display:flex;align-items:center;justify-content:space-between;gap:16px}.mobile-notifications-title{display:flex;align-items:center;gap:12px;font-size:24px;font-weight:700;color:var(--mobile-menu-text);margin:0;flex:1}.mobile-notifications-title .title-icon{width:24px;height:24px}.mobile-clear-all-btn{display:none;align-items:center;gap:6px;padding:8px 12px;background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);border-radius:10px;color:#ef4444;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s ease-out;white-space:nowrap}.mobile-clear-all-btn .clear-icon{width:14px;height:14px;flex-shrink:0}.mobile-clear-all-btn:hover{background:rgba(239,68,68,.25);border-color:rgba(239,68,68,.4);transform:scale(1.05)}.mobile-clear-all-btn:active{transform:scale(.95)}.mobile-menu-notifications-content{flex:1;overflow-y:auto}.mobile-notifications-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 24px;text-align:center}.mobile-notifications-empty .empty-state-icon{font-size:64px;margin-bottom:16px;opacity:.5}.mobile-notifications-empty .empty-state-text{font-size:16px;color:var(--mobile-menu-text);opacity:.6;margin:0}.mobile-notifications-list{display:flex;flex-direction:column;gap:12px;padding-bottom:24px}.mobile-notifications-list .notification-item{display:flex;align-items:flex-start;gap:12px;background:rgba(255,255,255,5%);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:16px;transition:all .3s cubic-bezier(.23,1,.32,1);position:relative;overflow:hidden;transform:translateX(0);opacity:1}.mobile-notifications-list .notification-item::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:0 0;transition:background .2s ease-out}.mobile-notifications-list .notification-item:active{transform:scale(.98)}.mobile-notifications-list .notification-item.unread{background:rgba(79,209,199,.12);border-color:rgba(79,209,199,.25)}.mobile-notifications-list .notification-item.unread::before{background:var(--mobile-menu-accent)}.mobile-notifications-list .notification-item.success::before{background:#10b981}.mobile-notifications-list .notification-item.warning::before{background:#f59e0b}.mobile-notifications-list .notification-item.error::before{background:#ef4444}.mobile-notifications-list .notification-icon{font-size:24px;flex-shrink:0;width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,8%);border-radius:8px;margin-top:2px}.mobile-notifications-list .notification-content{flex:1;min-width:0}.mobile-notifications-list .notification-content .notification-title{font-size:15px;font-weight:600;color:var(--mobile-menu-text);margin-bottom:4px;line-height:1.4}.mobile-notifications-list .notification-content .notification-message{font-size:14px;color:var(--mobile-menu-text);opacity:.8;line-height:1.5;margin-bottom:8px;word-wrap:break-word}.mobile-notifications-list .notification-content .notification-time{font-size:12px;color:var(--mobile-menu-text);opacity:.5;font-weight:500}.mobile-notifications-list .notification-close{flex-shrink:0;width:28px;height:28px;border-radius:8px;border:none;background:rgba(255,255,255,8%);color:var(--mobile-menu-text);font-size:20px;line-height:1;cursor:pointer;transition:all .2s ease-out;display:flex;align-items:center;justify-content:center;margin-top:2px}.mobile-notifications-list .notification-close:hover{background:rgba(255,255,255,.15);transform:scale(1.1)}.mobile-notifications-list .notification-close:active{transform:scale(.95)}[data-theme=light] .mobile-notifications-back-btn{background:rgba(0,0,0,5%);border-color:rgba(0,0,0,.1)}[data-theme=light] .mobile-notifications-back-btn:hover{background:rgba(0,0,0,8%)}[data-theme=light] .mobile-clear-all-btn{background:rgba(239,68,68,.1);border-color:rgba(239,68,68,.2);color:#dc2626}[data-theme=light] .mobile-clear-all-btn:hover{background:rgba(239,68,68,.15);border-color:rgba(239,68,68,.3)}[data-theme=light] .mobile-notifications-list .notification-item{background:rgba(255,255,255,.8);border-color:rgba(0,0,0,8%)}[data-theme=light] .mobile-notifications-list .notification-item.unread{background:rgba(0,112,243,8%);border-color:rgba(0,112,243,.15)}[data-theme=light] .mobile-notifications-list .notification-item.unread::before{background:var(--mobile-menu-accent)}[data-theme=light] .mobile-notifications-list .notification-icon{background:rgba(0,0,0,5%)}[data-theme=light] .mobile-notifications-list .notification-close{background:rgba(0,0,0,5%)}[data-theme=light] .mobile-notifications-list .notification-close:hover{background:rgba(0,0,0,.1)}@media(prefers-reduced-motion:reduce){.mobile-menu-toggle,.mobile-menu-dropdown,.mobile-menu-overlay,.mobile-notifications-back-btn{transition-duration:50ms}}