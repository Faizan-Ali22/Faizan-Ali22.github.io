@charset "UTF-8";.unified-modal{display:none;position:fixed;inset:0;width:100%;height:100%;background:rgba(0,0,0,.8);z-index:10000;backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;overflow:auto}.unified-modal .unified-modal-content{max-width:90vw;max-height:90vh;margin:0 auto;background:rgba(30,30,30,.98);border:1px solid rgba(255,255,255,.2);border-radius:20px;box-shadow:0 25px 45px rgba(0,0,0,.1),inset 0 1px rgba(255,255,255,.2);overflow:hidden;position:relative}.unified-modal-content--contact{width:800px;max-width:calc(100vw - 40px);min-height:420px}.unified-modal-demo .unified-modal-content{background:rgba(30,30,30,.98);border:1px solid rgba(255,255,255,.2);border-radius:20px;box-shadow:0 25px 45px rgba(0,0,0,.1),inset 0 1px rgba(255,255,255,.2);max-width:900px;width:100%;position:relative;overflow:hidden}.unified-modal-preview .unified-modal-content{background:rgba(30,30,30,.98);border:1px solid rgba(255,255,255,.2);border-radius:20px;box-shadow:0 25px 45px rgba(0,0,0,.1),inset 0 1px rgba(255,255,255,.2);max-width:900px;width:100%;position:relative;overflow:hidden}.unified-modal-header{position:relative;padding:15px 70px 0 20px;border-radius:20px 20px 0 0;overflow:hidden}.unified-modal-header .unified-modal-close{position:absolute;top:15px;right:20px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;font-size:24px;color:rgba(255,255,255,.8);cursor:pointer;transition:all .3s ease;z-index:10}.unified-modal-header .unified-modal-close:hover{background:rgba(255,255,255,.2);color:#fff;transform:scale(1.05)}.unified-modal-header .unified-modal-content-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;margin-top:10px}.unified-modal-header .unified-modal-tabs{margin:15px -20px 0;width:calc(100% + 90px);padding:8px 20px;background:rgba(0,0,0,.25);border-radius:0;border:none;box-sizing:border-box;position:relative;box-shadow:inset 0 1px rgba(255,255,255,5%),inset 0 -1px rgba(0,0,0,.1)}.unified-modal-body{padding:20px;background:#222;border-top:none;border-radius:0 0 20px 20px;max-height:75vh;overflow-y:auto}.unified-modal-content-header{gap:20px}.unified-modal-content-header .unified-modal-content-header-left{display:flex;align-items:flex-start;gap:20px;flex:1;min-width:0}.unified-modal-content-header .unified-modal-content-header-right{display:flex;align-items:center;gap:15px;flex-shrink:0}.unified-modal-icon-large{flex-shrink:0}.unified-modal-icon-large img{width:64px;height:64px;object-fit:contain}.unified-modal-icon-large span{display:block;font-size:48px;line-height:1}.unified-modal-title-block h2{margin:0 0 10px;font-size:28px;font-weight:700;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.3)}.unified-modal-chips{display:flex;gap:8px;flex-wrap:wrap}.unified-modal-chips .chip{background:rgba(74,222,128,.2);border:1px solid rgba(74,222,128,.3);color:#4ade80;padding:6px 12px;border-radius:20px;font-size:12px;font-weight:600}.unified-modal-chips .chip.secondary{background:rgba(156,163,175,.2);border-color:rgba(156,163,175,.3);color:#9ca3af}.unified-modal-two-columns{display:grid;grid-template-columns:1fr 1fr;gap:30px}.unified-modal-two-columns h4{margin:0 0 20px;color:#fff;font-weight:600;font-size:16px;display:flex;align-items:center;gap:8px}.unified-modal-two-columns .contact-info-column,.unified-modal-two-columns .contact-form-column{min-width:0}.unified-modal-tabs{margin-bottom:25px}.unified-modal-tabs .tab-btn .count{margin-left:8px;background:rgba(255,255,255,.2);padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600}.unified-modal-tabs .tab-btn.active .count{background:rgba(255,255,255,.3)}.unified-modal-panels .unified-modal-panel{display:none}.unified-modal-panels .unified-modal-panel.active{display:block}.unified-modal-simple-content p{color:rgba(255,255,255,.9);line-height:1.6;margin-bottom:15px}.unified-modal-simple-content .note{font-size:14px;color:rgba(255,255,255,.7);font-style:italic}.projects-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}.project-card,.experience-item,.formation-item{background:rgba(255,255,255,5%);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:20px}.project-card h4,.experience-item h4,.formation-item h4{margin:0 0 8px;color:#fff;font-weight:600}.project-card p,.experience-item p,.formation-item p{margin:0 0 15px;color:rgba(255,255,255,.8);font-size:14px}.project-card .card-actions,.project-card .item-actions,.experience-item .card-actions,.experience-item .item-actions,.formation-item .card-actions,.formation-item .item-actions{margin-top:15px}.experiences-list,.formations-list{display:flex;flex-direction:column;gap:15px}.contact-info{display:flex;flex-direction:column;gap:20px}.contact-item{display:flex;align-items:center;gap:15px;padding:15px;background:rgba(255,255,255,5%);border:1px solid rgba(255,255,255,.1);border-radius:12px;transition:all .3s ease}.contact-item:hover{background:rgba(255,255,255,8%);border-color:rgba(255,255,255,.2);transform:translateY(-1px)}.contact-item .contact-icon{font-size:24px;flex-shrink:0}.contact-item .contact-details{flex:1}.contact-item .contact-details .contact-title{font-weight:600;color:#fff;margin-bottom:4px;font-size:14px}.contact-item .contact-details .contact-value{color:rgba(255,255,255,.8);font-size:13px}.contact-item .contact-link{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:rgba(79,209,199,.1);border:1px solid rgba(79,209,199,.3);color:#4fd1c7;text-decoration:none;transition:all .3s ease;flex-shrink:0}.contact-item .contact-link:hover{background:rgba(79,209,199,.2);border-color:rgba(79,209,199,.5);transform:scale(1.05)}.contact-item .contact-link svg{width:16px;height:16px}.contact-form-content .contact-form{display:flex;flex-direction:column;gap:20px}.contact-form-content .form-group{display:flex;flex-direction:column;gap:8px}.contact-form-content .form-group label{font-weight:600;color:#fff;font-size:14px}.contact-form-content .form-group input,.contact-form-content .form-group textarea{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:12px;color:#fff;font-size:14px}.contact-form-content .form-group input::placeholder,.contact-form-content .form-group textarea::placeholder{color:rgba(255,255,255,.5)}.contact-form-content .form-group input:focus,.contact-form-content .form-group textarea:focus{outline:none;border-color:rgba(74,222,128,.5);box-shadow:0 0 0 2px rgba(74,222,128,.1)}.contact-form-content .form-actions{margin-top:10px}.about-content p{color:rgba(255,255,255,.9);line-height:1.6;font-size:15px}.skills-content .skills-list{display:flex;gap:8px;flex-wrap:wrap}.skills-content .skills-list .skill-tag{background:rgba(59,130,246,.2);border:1px solid rgba(59,130,246,.3);color:#60a5fa;padding:8px 14px;border-radius:20px;font-size:13px;font-weight:600}.discord-id-display{display:flex;align-items:center;gap:15px;background:0 0;border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:15px;margin:15px 0}.discord-id-display .discord-id{background:rgba(0,0,0,.2);padding:8px 12px;border-radius:6px;color:rgba(255,255,255,.9);font-family:courier new,monospace;font-weight:600;flex:1}.discord-id-display .btn-action.copied{background:rgba(74,222,128,.2);border:1px solid rgba(74,222,128,.5);color:#4ade80}.discord-id-display .btn-action.copy-error{background:rgba(244,63,94,.2);border:1px solid rgba(244,63,94,.5);color:#f43f5e}.unified-modal-content--contact .btn-action.copied{background:rgba(74,222,128,.2);border:1px solid rgba(74,222,128,.5);color:#4ade80}.unified-modal-content--contact .btn-action.copy-error{background:rgba(244,63,94,.2);border:1px solid rgba(244,63,94,.5);color:#f43f5e}.simple-actions{margin-top:20px}.actions-list{display:flex;flex-direction:column;gap:15px}.cv-content .cv-options{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:12px}.cv-content .cv-option{display:flex;align-items:center;gap:14px;justify-content:flex-start;white-space:normal;padding:16px;width:100%;background:rgba(255,255,255,6%);border:1px solid rgba(255,255,255,.12);border-radius:12px;color:rgba(255,255,255,.95);cursor:pointer;transition:transform .2s ease,background .2s ease,border-color .2s ease;text-align:left}.cv-content .cv-option:hover{transform:translateY(-2px);background:rgba(255,255,255,8%);border-color:rgba(255,255,255,.2)}.cv-content .cv-option:focus-visible{outline:2px solid #667eea;outline-offset:2px}.cv-content .cv-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:10px;background:rgba(255,255,255,8%);color:#fff;flex-shrink:0}.cv-content .cv-icon svg{width:24px;height:24px}.cv-content .cv-text{flex:1}.cv-content .cv-title{font-weight:700;margin-bottom:4px}.cv-content .cv-desc{color:rgba(255,255,255,.75);font-size:13px}.cv-content .badge{display:inline-block;margin-top:8px;background:var(--glass-bg,rgba(255,255,255,8%));border:1px solid var(--primary-blue-border,rgba(52,152,219,.4));color:var(--primary-blue,#3498db);padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600}.action-item{display:flex;align-items:center;gap:15px;padding:20px;background:rgba(255,255,255,5%);border:1px solid rgba(255,255,255,.1);border-radius:12px;transition:all .3s ease;width:100%;text-align:left;cursor:pointer;font-family:inherit;position:relative}.action-item::after{content:'→';font-size:20px;color:rgba(255,255,255,.4);margin-left:auto;transition:all .3s ease}.action-item:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.2);transform:translateX(4px);box-shadow:0 4px 12px rgba(0,0,0,.3)}.action-item:hover::after{color:rgba(255,255,255,.9);transform:translateX(4px)}.action-item:hover .action-title{color:#fff}.action-item:active{transform:translateX(2px)}.action-item .action-icon{font-size:32px;flex-shrink:0;color:rgba(255,255,255,.9)}.action-item .action-content{flex:1}.action-item .action-content .action-title{font-weight:600;color:rgba(255,255,255,.95);margin-bottom:4px;font-size:16px;transition:color .3s ease}.action-item .action-content .action-desc{color:rgba(255,255,255,.6);font-size:13px;text-transform:uppercase;letter-spacing:.5px}@media(max-width:1024px) and (min-width:769px){.unified-modal-two-columns{gap:25px}}@media(max-width:768px){.unified-modal,.unified-modal.unified-modal--projectWidget{padding:0!important;align-items:stretch!important;justify-content:stretch!important;backdrop-filter:none!important}.unified-modal-content{width:100vw!important;height:100dvh!important;max-width:100vw!important;max-height:100dvh!important;margin:0!important;border-radius:0!important;border:none!important;display:flex!important;flex-direction:column!important}.unified-modal-demo .unified-modal-content,.unified-modal-preview .unified-modal-content{width:100vw!important;height:100dvh!important;max-width:100vw!important;max-height:100dvh!important;margin:0!important;border-radius:0!important;border:none!important;display:flex!important;flex-direction:column!important}.unified-modal-header{padding:15px 60px 0 15px;border-radius:0}.unified-modal-header .unified-modal-close{right:15px;width:35px;height:35px;font-size:20px}.unified-modal-body{border-radius:0;flex:1!important;overflow-y:auto!important;overflow-x:hidden!important;-webkit-overflow-scrolling:touch}.unified-modal-content-header{flex-direction:column;gap:15px}.unified-modal-content-header .unified-modal-content-header-left{width:100%;max-width:100%}.unified-modal-content-header .unified-modal-content-header-right{width:100%;justify-content:center}.contact-social-actions{justify-content:center}.unified-modal-two-columns{grid-template-columns:1fr;gap:25px}.unified-modal-quick-stats{gap:15px}.projects-grid{grid-template-columns:1fr}.contact-item{flex-direction:column;text-align:center;gap:10px}.action-item{flex-direction:column;text-align:center;gap:15px}.action-item .action-content{order:1}.action-item .btn-action{order:2}.discord-id-display{flex-direction:column;gap:10px;text-align:center}.cv-content .cv-options{grid-template-columns:1fr}}.contact-social-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;align-items:center}.unified-modal.fade-enter{opacity:0}.unified-modal.fade-enter .unified-modal-content{transform:translateY(-20px)scale(.95)}.unified-modal.fade-enter-active{opacity:1;transition:opacity .3s ease}.unified-modal.fade-enter-active .unified-modal-content{transform:translateY(0)scale(1);transition:transform .3s cubic-bezier(.34,1.56,.64,1)}.unified-modal.fade-exit{opacity:1}.unified-modal.fade-exit .unified-modal-content{transform:translateY(0)scale(1)}.unified-modal.fade-exit-active{opacity:0;transition:opacity .3s ease}.unified-modal.fade-exit-active .unified-modal-content{transform:translateY(-20px)scale(.95);transition:transform .3s ease}.unified-modal-chips .chip.primary{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff}.unified-modal-chips .chip.secondary{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.8)}.unified-modal-chips .chip.accent{background:linear-gradient(135deg,#f093fb 0%,#f5576c 100%);color:#fff}.unified-modal-chips .chip.success{background:linear-gradient(135deg,#4ecdc4 0%,#44a08d 100%);color:#fff}.unified-modal-chips .chip.warning{background:linear-gradient(135deg,#ffecd2 0%,#fcb69f 100%);color:#8b4513}.unified-modal-tabs .tab-btn .count{background:rgba(255,255,255,.2);border-radius:12px;padding:2px 8px;font-size:12px;font-weight:600;margin-left:8px;min-width:20px;text-align:center}.unified-modal-tabs .tab-btn.active .count{background:rgba(255,255,255,.9);color:#333}.error-content{padding:40px;text-align:center}.error-content .error-message{background:rgba(255,0,0,.1);border:1px solid rgba(255,0,0,.3);border-radius:12px;padding:20px}.error-content .error-message h3{color:#ff4757;margin:0 0 10px}.error-content .error-message p{color:rgba(255,255,255,.7);margin:0}@media(max-width:768px){.unified-modal-body{padding:15px!important}.unified-modal-two-columns{flex-direction:column;gap:30px}.unified-modal-two-columns .contact-info-column,.unified-modal-two-columns .contact-form-column{width:100%}.contact-social-actions{justify-content:center;margin-top:15px}.unified-modal-content-header{flex-direction:column;align-items:flex-start!important;gap:15px}.unified-modal-content-header .unified-modal-content-header-left{width:100%}.unified-modal-content-header .unified-modal-content-header-right{width:100%}}@media(max-width:480px){.unified-modal-tabs{flex-wrap:wrap;gap:8px}.unified-modal-tabs .tab-btn{flex:1;min-width:calc(50% - 4px)}.unified-modal-tabs .tab-btn .tab-label{display:none}.unified-modal-tabs .tab-btn .tab-icon{font-size:20px}.projects-grid{grid-template-columns:1fr}}.unified-modal:focus-within{outline:none}.unified-modal-close:focus-visible,.tab-btn:focus-visible,.btn-action:focus-visible,.btn-action-icon:focus-visible{outline:2px solid #667eea;outline-offset:2px}@media(prefers-color-scheme:dark){.unified-modal-content{background:rgba(25,25,25,.95);border-color:rgba(255,255,255,.1)}.error-content .error-message{background:rgba(139,0,0,.2);border-color:rgba(255,69,0,.4)}}.modal-types-navigation{background:rgba(40,40,40,.95);border:1px solid rgba(255,255,255,.2);border-radius:16px;padding:24px;margin-bottom:32px}.modal-types-navigation h3{margin:0 0 20px;color:rgba(255,255,255,.9);font-size:18px;font-weight:600}.modal-types-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px}.modal-type-item{display:flex;align-items:center;padding:16px;background:rgba(255,255,255,5%);border:1px solid rgba(255,255,255,.1);border-radius:12px;transition:all .3s ease}.modal-type-item:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.3);transform:translateY(-2px)}.modal-type-item .modal-type-icon{font-size:24px;margin-right:12px;flex-shrink:0}.modal-type-item strong{color:rgba(255,255,255,.9);font-weight:600;margin-right:8px}.modal-type-item .modal-type-file{font-family:monaco,menlo,monospace;font-size:11px;color:rgba(255,255,255,.6);background:rgba(0,0,0,.2);padding:4px 8px;border-radius:6px;margin-left:auto;flex-shrink:0}.demo-actions{margin-top:40px}.demo-actions h3{color:rgba(255,255,255,.9);margin-bottom:20px;font-size:20px}.demo-buttons{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}.demo-buttons .demo-btn{padding:16px 24px;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);border:none;border-radius:12px;color:#fff;font-weight:600;font-size:14px;cursor:pointer;transition:all .3s ease;box-shadow:0 4px 15px rgba(102,126,234,.3)}.demo-buttons .demo-btn:hover{transform:translateY(-3px);box-shadow:0 8px 25px rgba(102,126,234,.4)}.demo-buttons .demo-btn:active{transform:translateY(0)}@media(max-width:768px){.modal-types-list{grid-template-columns:1fr}.modal-type-item{flex-direction:column;align-items:flex-start}.modal-type-item .modal-type-icon{margin-bottom:8px;margin-right:0}.modal-type-item .modal-type-file{margin-left:0;margin-top:8px}.demo-buttons{grid-template-columns:1fr}}