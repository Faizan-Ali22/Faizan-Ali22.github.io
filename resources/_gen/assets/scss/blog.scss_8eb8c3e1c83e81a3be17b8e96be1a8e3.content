@charset "UTF-8";:root{--blog-primary-color:var(--accent, #4fd1c7);--blog-primary-alpha:var(--blog-accent-20, rgba(79, 209, 199, 0.2));--blog-glass-bg:var(--glass-bg, rgba(55, 65, 81, 0.3));--blog-glass-border:var(--glass-border, rgba(255, 255, 255, 0.1));--blog-text-primary:var(--text-primary, #ffffff);--blog-text-secondary:var(--text-secondary, rgba(255, 255, 255, 0.8));--blog-text-muted:var(--text-muted, rgba(255, 255, 255, 0.6));--blog-border-radius:20px;--blog-transition:var(--transition-smooth, all 0.3s ease)}.blog-theme{margin:4rem auto;width:100%;display:flex;justify-content:center;align-items:flex-start}.blog-theme.blog-single-page{display:block;margin:80px auto 2rem;max-width:1152px;width:100%;padding:2rem 1rem;box-sizing:border-box;background:0 0;border:none;border-radius:0;backdrop-filter:none;box-shadow:none}@media(max-width:768px){.blog-theme.blog-single-page{margin:0;padding:0;max-width:100%;width:100%}}.blog-theme.posts-list-page{display:block;margin:2rem auto;max-width:1400px;width:100%;padding:6rem 1rem 2rem;box-sizing:border-box;background:0 0;backdrop-filter:none;border-radius:0;border:none;box-shadow:none;overflow:visible}@media(max-width:768px){.blog-theme{margin:2rem 1rem}}.blog-section{max-width:1400px;margin:4rem auto;padding:0;width:100%}.blog-section .blog-header{text-align:center;margin-bottom:3rem;padding:0 2rem}.blog-section .blog-header h2{color:var(--blog-text-primary);font-size:2.5rem;font-weight:700;margin-bottom:1rem;text-shadow:0 2px 10px rgba(0,0,0,.5)}.blog-section .blog-subtitle{color:var(--blog-text-secondary);font-size:1.1rem;line-height:1.6;max-width:600px;margin:0 auto}@media(max-width:768px){.blog-section{padding:0}}.blog-tabs{display:flex;justify-content:center;gap:.3rem;margin-bottom:2rem;background:var(--blog-glass-bg);backdrop-filter:blur(15px);border-radius:25px;padding:.3rem;width:fit-content;margin-left:auto;margin-right:auto;border:1px solid var(--blog-glass-border);box-shadow:0 4px 20px rgba(0,0,0,.2)}.blog-tab-btn{background:0 0;border:none;color:var(--blog-text-muted);padding:.8rem 2rem;border-radius:20px;cursor:pointer;transition:var(--blog-transition);font-weight:500;font-size:.95rem;position:relative;overflow:hidden}.blog-tab-btn:hover{background:var(--blog-primary-alpha);color:var(--blog-text-secondary);transform:translateY(-1px)}.blog-tab-btn.active{background:var(--blog-primary-alpha);color:var(--blog-text-primary);box-shadow:0 2px 10px var(--blog-accent-30,rgba(79,209,199,.3))}.blog-search{display:flex;justify-content:center;margin-bottom:2rem}.blog-search-input{background:var(--blog-glass-bg);border:1px solid var(--blog-glass-border);color:var(--blog-text-primary);padding:1rem 1.5rem;border-radius:25px;width:100%;max-width:400px;backdrop-filter:blur(10px);font-size:1rem;transition:var(--blog-transition)}.blog-search-input::placeholder{color:var(--blog-text-muted)}.blog-search-input:focus{outline:none;border-color:var(--blog-accent-50,rgba(79,209,199,.5));box-shadow:0 0 20px var(--blog-accent-30,rgba(79,209,199,.3));background:rgba(var(--slate-rgb,55,65,81),.5)}.blog-filter-controls{background:var(--blog-glass-bg);backdrop-filter:blur(20px);border-radius:var(--blog-border-radius);padding:1.5rem;margin-bottom:2rem;border:1px solid var(--blog-glass-border);box-shadow:0 8px 32px rgba(0,0,0,.2)}@media(max-width:768px){.blog-filter-controls{padding:1rem;margin-bottom:1.5rem}}.blog-filter-section{display:flex;flex-wrap:wrap;align-items:center;gap:1rem}@media(max-width:768px){.blog-filter-section{flex-direction:column;align-items:flex-start;gap:.8rem}}.blog-filter-label{color:var(--blog-text-primary);font-weight:600;font-size:1rem;margin-right:.5rem;white-space:nowrap}@media(max-width:768px){.blog-filter-label{font-size:.9rem}}.blog-tag-filter{background:rgba(255,255,255,.1);border:1px solid var(--blog-glass-border);color:var(--blog-text-secondary);padding:.5rem 1rem;border-radius:20px;cursor:pointer;transition:var(--blog-transition);font-size:.85rem;font-weight:500;positi