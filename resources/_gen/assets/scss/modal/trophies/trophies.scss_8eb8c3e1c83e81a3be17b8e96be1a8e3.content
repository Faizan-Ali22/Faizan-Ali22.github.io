@charset "UTF-8";.trophies-container{position:relative}.trophies-btn{position:relative;min-width:80px!important;padding:6px 12px!important;flex-direction:column!important;gap:2px!important;background:rgba(255,215,0,.1)!important;border:1px solid rgba(255,215,0,.3)!important}.trophies-btn:hover{background:rgba(255,215,0,.2)!important;border-color:rgba(255,215,0,.5)!important}.trophy-count{font-size:.75rem;font-weight:700;color:gold;letter-spacing:.5px;text-shadow:0 1px 2px rgba(0,0,0,.3);margin-top:1px}.trophy-progress{width:100%;height:4px;background:rgba(255,215,0,.2);border-radius:2px;overflow:hidden;box-shadow:inset 0 1px 2px rgba(0,0,0,.1)}.trophy-progress-bar{height:100%;background:linear-gradient(90deg,#FFD700 0%,#FFA500 100%);border-radius:2px;transition:width .5s ease;box-shadow:0 0 4px rgba(255,215,0,.4);width:0%}.trophies-btn.new-trophy{animation:pulse-trophy 1s ease-in-out}@keyframes pulse-trophy{0%,100%{background:rgba(255,215,0,.1)!important;border-color:rgba(255,215,0,.3)!important;transform:scale(1)}50%{background:rgba(255,215,0,.3)!important;border-color:rgba(255,215,0,.6)!important;transform:scale(1.05);box-shadow:0 0 20px rgba(255,215,0,.4)}}@media(max-width:480px){.trophies-btn{min-width:60px!important;padding:4px 8px!important}.trophy-count{font-size:.7rem}}.trophies-modal{position:fixed;top:0;left:0;width:100vw;height:100dvh;z-index:9999;opacity:0;visibility:hidden;transition:all .3s ease;overflow:hidden}.trophies-modal.active{opacity:1;visibility:visible}.trophies-modal-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.3);backdrop-filter:blur(10px)}.trophies-modal-content{position:relative;width:100%;height:100%;display:flex;flex-direction:column;background:linear-gradient(135deg,rgba(20,20,30,.6),rgba(30,30,50,.6));backdrop-filter:blur(15px);animation:modalSlideIn .4s ease-out;overflow:hidden}@keyframes modalSlideIn{from{transform:translateY(50px);opacity:0}to{transform:translateY(0);opacity:1}}.trophies-modal-header{display:flex;flex-direction:column;gap:24px;padding:30px 40px 40px;border-bottom:1px solid rgba(255,255,255,8%);background:linear-gradient(135deg,rgba(255,215,0,3%),rgba(255,165,0,1%));position:relative;flex-shrink:0}.modal-title-section{display:flex;flex-direction:column;gap:6px;padding-right:60px}.modal-title{font-size:2.5rem;font-weight:800;margin:0;background:linear-gradient(135deg,#FFD700,#FFA500);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;text-shadow:0 0 30px rgba(255,215,0,.3)}.modal-subtitle{font-size:1rem;color:rgba(255,255,255,.6);margin:6px 0 0;font-weight:400}.modal-close-btn{background:rgba(255,255,255,5%);border:1px solid rgba(255,255,255,.1);border-radius:50%;width:48px;height:48px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .3s ease;color:rgba(255,255,255,.8);backdrop-filter:blur(10px);flex-shrink:0;position:absolute;top:30px;right:40px}.modal-close-btn:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.2);transform:scale(1.05);color:#fff}.modal-progress-section{width:100%}.overall-progress{max-width:600px}.progress-label{display:block;font-size:.85rem;color:rgba(255,255,255,.5);margin-bottom:10px;font-weight:500;text-transform:uppercase;letter-spacing:.5px}.progress-bar-container{display:flex;align-items:center;gap:16px}.progress-bar-bg{flex:1;height:10px;background:rgba(255,255,255,8%);border-radius:5px;overflow:hidden;position:relative;box-shadow:inset 0 2px 4px rgba(0,0,0,.2)}.progress-bar-fill{height:100%;background:linear-gradient(90deg,#FFD700,#FFA500);width:0%;transition:width .6s ease;border-radius:5px;box-shadow:0 0 10px rgba(255,215,0,.5);position:relative}.progress-bar-fill::after{content:'';position:absolute;top:0;left:0;right:0;height:50%;background:linear-gradient(180deg,rgba(255,255,255,.2),transparent);border-radius:5px 5px 0 0}.progress-text{font-size:1.2rem;font-weight:700;color:gold;min-width:70px;text-align:right;text-shadow:0 0 10px rgba(255,215,0,.3)}.trophies-modal-body{flex:1;overflow-y:auto;overflow-x:hidden;scrollbar-width:thin;scrollbar-color:rgba(255,215,0,.3)transparent}.trophies-modal-body::-webkit-scrollbar{width:8px}.trophies-modal-body::-webkit-scrollbar-track{background:0 0}.trophies-modal-body::-webkit-scrollbar-thumb{background:rgba(255,215,0,.3);border-radius:4px}.trophies-modal-body::-webkit-scrollbar-thumb:hover{background:rgba(255,215,0,.5)}.trophies-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:24px;max-width:1400px;margin:0 auto;padding:48px 40px;width:100%}.trophy-card{background:rgba(255,255,255,2%);border:1px solid rgba(255,255,255,5%);border-radius:16px;padding:24px;transition:all .3s ease;position:relative;overflow:hidden;backdrop-filter:blur(10px)}.trophy-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:var(--trophy-gradient);opacity:0;transition:opacity .3s ease}.trophy-card:hover{transform:translateY(-4px);background:rgba(255,255,255,4%);border-color:rgba(255,255,255,.1);box-shadow:0 8px 32px rgba(0,0,0,.2)}.trophy-card:hover::before{opacity:1}.trophy-card.unlocked{background:linear-gradient(135deg,rgba(255,215,0,5%),rgba(255,165,0,2%));border-color:rgba(255,215,0,.15);--trophy-gradient:linear-gradient(90deg, #FFD700, #FFA500)}.trophy-card.locked{opacity:.6;--trophy-gradient:linear-gradient(90deg, #666, #888)}.trophy-card-header{display:flex;align-items:center;gap:16px;margin-bottom:16px}.trophy-card-icon{width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2rem;position:relative;transition:all .3s ease}.trophy-card-icon.locked{background:rgba(128,128,128,.3);filter:grayscale(100%)}.trophy-card-icon.unlocked{background:linear-gradient(135deg,#FFD700,#FFA500);box-shadow:0 0 20px rgba(255,215,0,.4);animation:trophy-pulse 3s ease-in-out infinite}@keyframes trophy-pulse{0%,100%{box-shadow:0 0 20px rgba(255,215,0,.4);transform:scale(1)}50%{box-shadow:0 0 30px rgba(255,215,0,.6);transform:scale(1.05)}}.trophy-card-info{flex:1}.trophy-card-title{font-size:1.25rem;font-weight:700;color:#fff;margin:0 0 4px}.trophy-card-rarity{display:inline-block;padding:4px 8px;border-radius:6px;font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.5px}.trophy-card-rarity.common{background:rgba(169,169,169,.3);color:#a9a9a9}.trophy-card-rarity.rare{background:rgba(30,144,255,.3);color:#1e90ff}.trophy-card-rarity.epic{background:rgba(138,43,226,.3);color:#8a2be2}.trophy-card-rarity.legendary{background:rgba(255,215,0,.3);color:gold}.trophy-card-description{font-size:1rem;color:rgba(255,255,255,.8);line-height:1.5;margin:12px 0}.trophy-card-requirement{font-size:.9rem;color:rgba(255,255,255,.6);font-style:italic;margin-bottom:12px}.trophy-card-date{font-size:.85rem;color:gold;font-weight:600;display:flex;align-items:center;gap:6px}.trophy-card-date::before{content:'🗓️';font-size:.8rem}.trophies-modal-footer{padding:30px 40px;border-top:1px solid rgba(255,255,255,5%);background:rgba(0,0,0,.1)}.footer-stats{display:flex;justify-content:center;gap:40px;margin-bottom:20px}.stat-item{display:flex;flex-direction:column;align-items:center;gap:6px}.stat-icon{font-size:1.5rem}.stat-label{font-size:.9rem;color:rgba(255,255,255,.7);font-weight:600}.stat-value{font-size:1.25rem;color:gold;font-weight:700}.footer-hint{text-align:center;display:flex;align-items:center;justify-content:center;gap:8px;font-size:1rem;color:rgba(255,255,255,.6);font-style:italic}.hint-icon{font-size:1.2rem}.new-trophy-notification{position:fixed;top:20px;right:20px;transform:translateX(400px);background:linear-gradient(135deg,#FFD700,#FFA500);color:#000;padding:20px 30px;border-radius:16px;box-shadow:0 20px 60px rgba(255,215,0,.4);z-index:10100;text-align:center;min-width:300px;max-width:400px;opacity:0;transition:all .5s cubic-bezier(.4,0,.2,1);pointer-events:none}.new-trophy-notification.show{opacity:1;transform:translateX(0)}.new-trophy-notification .trophy-emoji{font-size:3rem;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;animation:bounce 1s ease-in-out infinite}@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}.new-trophy-notification .trophy-name{font-size:1.2rem;font-weight:700;margin-bottom:5px}.new-trophy-notification .trophy-desc{font-size:.9rem;opacity:.8}.trophy-unlock-animation{animation:trophy-unlock 1s ease-out}@keyframes trophy-unlock{0%{transform:scale(.5)rotate(-180deg);opacity:0}50%{transform:scale(1.2)rotate(0);opacity:1}100%{transform:scale(1)rotate(0);opacity:1}}.trophy-glow{animation:trophy-glow 2s ease-in-out infinite}@keyframes trophy-glow{0%,100%{box-shadow:0 0 15px rgba(255,215,0,.5);transform:scale(1)}50%{box-shadow:0 0 20px rgba(255,215,0,.8);transform:scale(1.05)}}@media(max-width:1024px){.trophies-modal-content{border-radius:0}.trophies-modal-header{padding:24px}.modal-title{font-size:2.2rem}.trophies-grid{grid-template-columns:repeat(2,1fr);gap:20px}.trophies-modal-footer{padding:24px}}@media(max-width:768px){.trophies-modal-content{background:linear-gradient(180deg,rgba(20,20,30,.98),rgba(15,15,25,.98))}.trophies-modal-header{flex-direction:column;gap:20px;padding:20px 60px 24px 20px;border-bottom:1px solid rgba(255,255,255,8%)}.modal-title-section{padding-right:0}.modal-title{font-size:1.8rem}.modal-subtitle{font-size:.9rem}.modal-close-btn{top:20px;right:20px;width:40px;height:40px}.modal-progress-section{width:100%}.overall-progress{max-width:100%}.progress-label{font-size:.8rem;margin-bottom:8px}.progress-bar-bg{height:8px}.progress-text{font-size:1rem}.trophies-modal-body{-webkit-overflow-scrolling:touch;overscroll-behavior:contain}.trophies-grid{padding:24px 16px;grid-template-columns:1fr;gap:12px}.trophy-card{padding:16px;border-radius:12px}.trophy-card-header{gap:12px;margin-bottom:12px}.trophy-card-icon{width:52px;height:52px;font-size:1.6rem;flex-shrink:0}.trophy-card-title{font-size:1.1rem}.trophy-card-rarity{font-size:.7rem;padding:3px 6px}.trophy-card-description{font-size:.9rem;line-height:1.4;margin:8px 0}.trophy-card-requirement{font-size:.85rem;margin-bottom:8px}.trophy-card-date{font-size:.8rem}.trophies-modal-footer{padding:16px 20px;border-top:1px solid rgba(255,255,255,8%);background:rgba(0,0,0,.2)}.footer-stats{flex-wrap:wrap;gap:16px;justify-content:space-around}.stat-item{min-width:calc(50% - 12px);text-align:center}.stat-value{font-size:1.5rem}.stat-label{font-size:.85rem}.new-trophy-notification{padding:16px 20px;margin:0 16px;max-width:calc(100vw - 32px);border-radius:12px}.new-trophy-notification .trophy-emoji{font-size:2rem}.new-trophy-notification h3{font-size:1.1rem}.new-trophy-notification p{font-size:.9rem}@keyframes modalSlideIn{from{transform:translateY(100%);opacity:0}to{transform:translateY(0);opacity:1}}.trophy-card:hover{transform:none}.trophy-card:active{transform:scale(.98);background:rgba(255,255,255,6%)}}@media(max-width:480px){.trophies-modal-header{padding:16px 56px 20px 16px;gap:16px}.modal-title-section{padding-right:0}.modal-title{font-size:1.5rem}.modal-subtitle{font-size:.85rem}.modal-close-btn{top:16px;right:16px;width:36px;height:36px}.modal-progress-section{padding-top:0}.progress-label{font-size:.75rem}.progress-bar-container{gap:12px}.trophies-grid{padding:20px 12px;gap:10px}.trophy-card{padding:14px}.trophy-card-header{gap:10px}.trophy-card-icon{width:46px;height:46px;font-size:1.4rem}.trophy-card-title{font-size:1rem}.trophy-card-description{font-size:.85rem}.trophy-card-requirement{font-size:.8rem}.trophies-modal-footer{padding:14px 16px}.footer-stats{gap:12px}.stat-item{min-width:calc(50% - 8px)}.stat-value{font-size:1.3rem}.stat-label{font-size:.8rem}}@media(max-width:360px){.trophies-modal-header{padding:14px 50px 18px 14px;gap:14px}.modal-title{font-size:1.3rem}.modal-subtitle{font-size:.8rem}.modal-close-btn{top:14px;right:14px;width:32px;height:32px}.progress-label{font-size:.7rem}.trophies-grid{padding:18px 10px}.trophy-card{padding:12px}.trophy-card-icon{width:42px;height:42px;font-size:1.2rem}.trophy-card-title{font-size:.95rem}.trophy-card-rarity{font-size:.65rem;padding:2px 5px}.trophy-card-description{font-size:.8rem}.stat-value{font-size:1.2rem}.stat-label{font-size:.75rem}*{animation-duration:.2s!important;transition-duration:.2s!important}}@media(max-width:768px) and (orientation:landscape){.trophies-modal-header{padding:12px 20px 16px;gap:12px}.modal-title{font-size:1.4rem}.modal-subtitle{display:none}.modal-close-btn{top:12px;right:20px}.progress-label{font-size:.75rem;margin-bottom:6px}.progress-bar-bg{height:6px}.trophies-grid{padding:16px 20px;grid-template-columns:repeat(2,1fr);gap:10px}.trophy-card{padding:12px}.trophy-card-icon{width:40px;height:40px;font-size:1.2rem}.trophy-card-description{font-size:.8rem;margin:6px 0}.trophies-modal-footer{padding:10px 20px}.footer-stats{gap:16px}.stat-item{min-width:auto}.stat-value{font-size:1.2rem}.stat-label{font-size:.75rem}}@media(max-width:768px){.trophy-card,.modal-close-btn{-webkit-tap-highlight-color:rgba(255,255,255,.1)}.trophy-card{cursor:pointer;user-select:none}.trophies-modal-body{-webkit-overflow-scrolling:touch;overscroll-behavior:contain}.trophy-card-title,.trophy-card-description,.modal-title{touch-action:manipulation}}